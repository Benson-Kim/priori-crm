# App
APP_NAME=Business Central
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false

# API
API_V1_PREFIX=/api/v1

# Database (PostgreSQL)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://priori:your_secure_password@localhost:5432/prioritech

DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600
DB_ECHO=false

# JWT
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your-generated-secret-key-at-least-32-characters-long
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# AWS SES
AWS_REGION=af-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
SES_SENDER_EMAIL=noreply@prioritech.com
SES_MAX_RETRIES=3

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://app.prioritech.com

# Context-aware access control (ABAC + zero trust, issue #67)
ABAC_ENABLED=true
# Only trust X-Geo-*/X-Device-Fingerprint headers behind an edge that sets
# and strips them (otherwise they are attacker-controlled).
ABAC_TRUST_CONTEXT_HEADERS=false
# Comma-separated: exact IPs, CIDR ranges, or literal client identifiers.
ABAC_IP_DENYLIST=
# Comma-separated ISO country codes to refuse (requires a geo signal).
ABAC_GEO_BLOCKLIST=
# Off-hours window (REPORTING_TIMEZONE local hours): sensitive access
# inside it requires an OTP step-up. start == end disables the window.
ABAC_OFF_HOURS_START=22
ABAC_OFF_HOURS_END=6
# Audit ALLOW decisions too (deny/challenge/terminate always audited).
ABAC_AUDIT_ALLOW_DECISIONS=true

# Continuous session risk scoring (issue #67)
RISK_CHALLENGE_THRESHOLD=60
RISK_TERMINATE_THRESHOLD=90
RISK_IMPOSSIBLE_TRAVEL_KMH=900
RISK_SCORE_IMPOSSIBLE_TRAVEL=70
RISK_SCORE_DEVICE_CHANGE=25
RISK_SCORE_VOLUME_ANOMALY=30
RISK_SCORE_PRIVILEGE_ESCALATION=25
RISK_VOLUME_WINDOW_SECONDS=60
RISK_VOLUME_MAX_REQUESTS=300

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BACKEND=memory
REDIS_URL=
RATE_LIMIT_TRUST_FORWARDED_FOR=false

# Auth abuse protection 
AUTH_MAX_OTP_ATTEMPTS=5
AUTH_MAX_RESET_ATTEMPTS=5
AUTH_LOGIN_MAX_ATTEMPTS=10
AUTH_LOGIN_WINDOW_SECONDS=300

# Password reset (forgot-password flow)
PASSWORD_RESET_EXPIRE_MINUTES=30
# Base URL of the frontend; used to build the reset link in the email
# (<FRONTEND_BASE_URL>/reset-password?token=...).
FRONTEND_BASE_URL=http://localhost:5173

# Refresh-token revocation denylist
TOKEN_DENYLIST_BACKEND=memory

# Monitoring
SENTRY_DSN=
LOG_LEVEL=INFO

# Batch Processing
BATCH_SIZE=1000
BATCH_TIMEOUT_SECONDS=300

# File Storage
STORAGE_BACKEND=local
UPLOAD_DIR=uploads
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_PRESIGN_EXPIRY=900

INTERNAL_API_SECRET=