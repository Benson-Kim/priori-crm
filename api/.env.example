# App
APP_NAME=Priori Technologies
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false

# API
API_V1_PREFIX=/api/v1

# Database (PostgreSQL)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://priori:your_secure_password@localhost:5432/prioritech

DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600
DB_ECHO=false

# JWT
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your-generated-secret-key-at-least-32-characters-long
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# AWS SES
AWS_REGION=af-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
SES_SENDER_EMAIL=noreply@prioritech.com
SES_MAX_RETRIES=3

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://app.prioritech.com

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# Monitoring
SENTRY_DSN=
LOG_LEVEL=INFO

# Batch Processing
BATCH_SIZE=1000
BATCH_TIMEOUT_SECONDS=300

# File Storage (P-13)
# Root directory all uploads are confined to (path-traversal safe).
UPLOAD_DIR=uploads
# Shared secret for internal machine-to-machine endpoints (e.g. nightly
# overdue-transition job). Leave empty to keep internal endpoints disabled.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_SECRET=