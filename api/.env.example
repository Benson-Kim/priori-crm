# App
APP_NAME=Business Central
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false

# API
API_V1_PREFIX=/api/v1

# Database (PostgreSQL)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://priori:your_secure_password@localhost:5432/prioritech

DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600
DB_ECHO=false

# JWT
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your-generated-secret-key-at-least-32-characters-long
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# AWS SES
AWS_REGION=af-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
SES_SENDER_EMAIL=noreply@prioritech.com
SES_MAX_RETRIES=3

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://app.prioritech.com
# Allowed request headers must include X-Device-Fingerprint: browser
# clients send it cross-origin when ABAC_TRUST_CONTEXT_HEADERS=true, and
# omitting it fails the preflight so the API silently falls back to the
# coarse derived fingerprint. (X-Geo-* are edge-stamped, not browser-sent,
# so they do not belong in this list. X-Internal-Secret does not either:
# it is a machine credential carried by schedulers/cron, never by browser
# JavaScript — preflight-approving it would invite cross-origin pages to
# carry the machine secret.)
#CORS_ALLOW_HEADERS=Authorization,Content-Type,X-Request-ID,X-Device-Fingerprint

# Context-aware access control (ABAC + zero trust, issue #67)
#
# IMPORTANT — what is actually live with the defaults below. The geo
# blocklist, the unknown-geo rule and impossible-travel detection ALL
# depend on a geolocation signal, and that signal only exists when
# ABAC_TRUST_CONTEXT_HEADERS=true behind an edge that sets the X-Geo-*
# headers. With the defaults they never fire. ABAC_IP_DENYLIST is empty.
# So out of the box the live protections are: the off-hours step-up,
# device-change / volume / privilege-escalation risk scoring, and the
# DB-layer fail-closed guard. Turning on the geo signals is a deployment
# step (see "Recommended production config" below), not a code change.
ABAC_ENABLED=true
# Only trust X-Geo-*/X-Device-Fingerprint headers behind an edge that sets
# and strips them (otherwise they are attacker-controlled).
ABAC_TRUST_CONTEXT_HEADERS=false
# Comma-separated: exact IPs, CIDR ranges, or literal client identifiers.
ABAC_IP_DENYLIST=
# Comma-separated ISO country codes to refuse (requires a geo signal).
ABAC_GEO_BLOCKLIST=
# Off-hours window (REPORTING_TIMEZONE local hours): sensitive access
# inside it requires an OTP step-up. start == end disables the window.
ABAC_OFF_HOURS_START=22
ABAC_OFF_HOURS_END=6
# How long one completed OTP satisfies the off-hours / unknown-geo rules.
# Sized to a work shift, not a transaction: at 30min a 22h->6h night would
# demand ~16 OTP emails. A stolen token can never produce this claim at any
# TTL, because minting it requires access to the user's inbox.
ABAC_STEP_UP_TTL_MINUTES=480
# Audit ALLOW decisions too (deny/challenge/terminate are ALWAYS audited
# regardless). Off by default: one extra INSERT on every business request
# is real write amplification, and allow-rows carry little evidentiary
# value. Turn on for a compliance window or while debugging policy.
ABAC_AUDIT_ALLOW_DECISIONS=false

# Continuous session risk scoring (issue #67).
# Graduated, evidence-weighted model: low risk (< challenge) = allow + log;
# moderate (>= challenge) = OTP step-up; high (>= terminate) = kill the
# session. The terminate threshold (100) deliberately sits ABOVE the
# largest possible single-request batch of SOFT signals (new device 25 +
# new country 25 + unusual hour 10 + mild volume 30 = 90), so the benign-
# unusual shapes — new place, new laptop, night work, one busy minute —
# can at worst reach a step-up challenge, never a termination. Only HARD
# signals (impossible travel, exfiltration-scale reads) or hard+soft
# corroboration cross the terminate line.
# Startup-validated invariants (the app refuses to boot otherwise):
#   RISK_CHALLENGE_THRESHOLD < RISK_TERMINATE_THRESHOLD
#     (challenge above terminate would leave soft-only scores between the
#     two matching NEITHER branch — a silent ALLOW), and
#   NEW_DEVICE + NEW_COUNTRY + UNUSUAL_HOUR + VOLUME_ANOMALY
#     < RISK_TERMINATE_THRESHOLD (and DEVICE_CHANGE + VOLUME_ANOMALY too),
#     so no single-evaluation batch of soft weights can be misconfigured
#     past the terminate line behind the soft-clamp's back.
RISK_CHALLENGE_THRESHOLD=60
RISK_TERMINATE_THRESHOLD=100
RISK_IMPOSSIBLE_TRAVEL_KMH=900
# Implied speed above the cap between consecutive geolocated requests.
# 70 alone forces a step-up. Whether the firing may go further is policy
# (RISK_IMPOSSIBLE_TRAVEL_MAX_ACTION below).
RISK_SCORE_IMPOSSIBLE_TRAVEL=70
# Ceiling on what impossible travel may cause. Default "challenge": in a
# mobile-heavy CGNAT market (this deployment: East Africa) carrier
# exit-node hopping makes IP geolocation jump cities between requests, so
# a firing still scores and still forces a step-up, but never counts as
# HARD evidence toward a termination — otherwise "new laptop + new place"
# (floor 50) plus one geolocation hop (70) would hard-lock exactly the
# user the soft-clamp protects. Set "terminate" only where the geo signal
# is trustworthy end-to-end (fixed-line users behind a verified edge).
RISK_IMPOSSIBLE_TRAVEL_MAX_ACTION=challenge
RISK_SCORE_DEVICE_CHANGE=25
RISK_SCORE_VOLUME_ANOMALY=30
RISK_SCORE_PRIVILEGE_ESCALATION=25
# SOFT signals vs the per-user behavioural baseline: scored once, on a
# session's first scored request, and only when the user HAS a baseline
# to deviate from. Devices/countries become "known" exclusively through a
# passed OTP step-up (verify_otp absorbs the verifying request's context),
# so a genuine user is challenged for a new device/place at most once.
RISK_SCORE_NEW_DEVICE=25
RISK_SCORE_NEW_COUNTRY=25
RISK_SCORE_UNUSUAL_HOUR=10
# Absorbed trust ages out: a device/country counts as known only this many
# days past its last VERIFIED use (a passed step-up re-stamps it). An
# aged-out context fires the soft signals again — one challenge, then
# re-absorption (and a fresh owner notification). Without aging, one
# compromised-inbox step-up whitelisted the attacker forever.
RISK_BASELINE_TRUST_TTL_DAYS=90
# Unusual-hour needs this many observed requests before it may fire:
# without history there are no "typical hours" to deviate from.
RISK_BASELINE_MIN_HOUR_OBSERVATIONS=50
RISK_VOLUME_WINDOW_SECONDS=60
RISK_VOLUME_MAX_REQUESTS=300
# Typical-volume learning: per-user, per-sensitivity-class EWMA of
# requests per window. After MIN_LEARNED_WINDOWS active windows the mild
# (soft) ceiling adapts to clamp(ewma * DEVIATION_MULTIPLIER, MIN_CEILING,
# RISK_VOLUME_MAX_REQUESTS); unlearned classes use the global ceiling.
RISK_VOLUME_DEVIATION_MULTIPLIER=4
RISK_VOLUME_MIN_CEILING=30
RISK_VOLUME_MIN_LEARNED_WINDOWS=3
RISK_VOLUME_LEARNING_ALPHA=0.3
# Baseline-learning write cadence: learn from 1-in-N scored requests per
# user, each applied observation weighted by N (statistically unbiased).
# Cuts the per-request UPDATE on the shared per-user baseline row by Nx.
# Set 1 to learn from every request (dev/test determinism).
RISK_BASELINE_LEARN_SAMPLE_N=8
# HARD: exfiltration-scale reads — this multiple of the global ceiling in
# one window (across all classes) terminates the session directly.
RISK_VOLUME_EXFIL_MULTIPLIER=5
RISK_SCORE_EXFILTRATION=100
# Export/bulk endpoints charge this many volume units per request instead
# of 1 (issue #51: exports bounded + audited): one export ≈ 25 point
# reads, so 60 exports/window reach the exfiltration ceiling that would
# otherwise need 1500 requests.
RISK_VOLUME_EXPORT_COST=25
# Points shed per hour since the last anomaly. Without decay the score is a
# ratchet and benign noise (browser update +25, busy minute +30, stray 403
# +25) eventually challenges a legitimate long-lived session. A session
# already flipped to challenge_required/terminated never decays back.
# Decay forgives TRANSIENT noise only: the session-start soft signals
# (new device/new country/unusual hour) anchor a non-decaying floor for
# the session's lifetime, so pacing anomalies against the decay clock
# cannot launder them. The floor dies with the session.
RISK_DECAY_PER_HOUR=10
# Session lifetimes; each terminates with its own audited reason.
SESSION_MAX_AGE_HOURS=24
SESSION_IDLE_TIMEOUT_MINUTES=720

# --- Recommended production config -------------------------------------
# Behind a CDN/reverse proxy that SETS and STRIPS the context headers
# (so a client cannot forge its own location), enable the geo signals:
#
#   ABAC_TRUST_CONTEXT_HEADERS=true
#   RATE_LIMIT_TRUST_FORWARDED_FOR=true
#   ABAC_GEO_BLOCKLIST=<ISO codes you never operate from>
#   ABAC_IP_DENYLIST=<known-bad IPs/CIDRs>
#
# Do NOT enable ABAC_TRUST_CONTEXT_HEADERS when the API is reachable
# directly: the headers are then attacker-supplied, and an attacker who
# can set X-Geo-Country can also spoof a plausible location to DEFEAT
# impossible-travel detection. Untrusted is the safer default.

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BACKEND=memory
REDIS_URL=
RATE_LIMIT_TRUST_FORWARDED_FOR=false

# Auth abuse protection 
AUTH_MAX_OTP_ATTEMPTS=5
AUTH_MAX_RESET_ATTEMPTS=5
AUTH_LOGIN_MAX_ATTEMPTS=10
AUTH_LOGIN_WINDOW_SECONDS=300

# Password reset (forgot-password flow)
PASSWORD_RESET_EXPIRE_MINUTES=30
# Base URL of the frontend; used to build the reset link in the email
# (<FRONTEND_BASE_URL>/reset-password?token=...).
FRONTEND_BASE_URL=http://localhost:5173

# Refresh-token revocation denylist
TOKEN_DENYLIST_BACKEND=memory

# Monitoring
SENTRY_DSN=
LOG_LEVEL=INFO

# Batch Processing
BATCH_SIZE=1000
BATCH_TIMEOUT_SECONDS=300

# File Storage
STORAGE_BACKEND=local
UPLOAD_DIR=uploads
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_PRESIGN_EXPIRY=900

# Shared machine secret for internal (service-to-service) callers, sent as
# the X-Internal-Secret header by trusted schedulers/cron jobs. EMPTY means
# DISABLED / fail-closed: an empty or unset secret never matches any header
# value, so the internal endpoints refuse all callers until a real secret
# is generated (python -c "import secrets; print(secrets.token_urlsafe(32))").
INTERNAL_API_SECRET=
edure:
#   1. Generate a new secret; set INTERNAL_API_SECRET_NEXT=<new>; restart.
#   2. Update every caller (scheduler CI variables, GitHub Actions secrets)
#      to send the new value.
#   3. Set INTERNAL_API_SECRET=<new>, clear INTERNAL_API_SECRET_NEXT; restart.
# Leave empty outside a rotation window.
INTERNAL_API_SECRET_NEXT=
